// Модуль формы расширения — обработка кнопки "Прочитать файл"
// Страница чтения XML: чтение XML файла формата ФНС (ON_NSCHFDOPPR),
// извлечение кодов маркировки (КИЗ) и заполнение таблицы ТаблицаДанныхИзФайла.
// Поиск номенклатуры по GTIN (13 цифр после "010") в регистре ШтрихкодыНоменклатуры.
//
// Структура XML:
//   Файл → Документ → ТаблСчФакт → СведТов (НаимТов, ...)
//     → ДопСведТов (КодТов = артикул) → НомСредИдентТов → КИЗ (код маркировки)

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьФайл(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "XML файлы (*.xml)|*.xml";
	Диалог.МножественныйВыбор = Ложь;

	ОповещениеЗавершения = Новый ОписаниеОповещения("ПослеПомещенияФайлов", ЭтотОбъект);
	НачатьПомещениеФайлов(ОповещениеЗавершения,, Диалог,, УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеПомещенияФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПомещенныеФайлы = Неопределено ИЛИ ПомещенныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	АдресФайла = ПомещенныеФайлы[0].Хранение;
	ЗаполнитьТаблицуИзXMLНаСервере(АдресФайла);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуИзXMLНаСервере(АдресФайла)

	ТаблицаДанныхИзФайла.Очистить();

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		ЧтениеXML.Закрыть();
	Исключение
		Сообщить("Ошибка чтения XML файла: " + ОписаниеОшибки());
		УдалитьФайлы(ИмяВременногоФайла);
		Возврат;
	КонецПопытки;

	УдалитьФайлы(ИмяВременногоФайла);

	// Получить все строки товаров: Файл → Документ → ТаблСчФакт → СведТов
	СписокТоваров = ДокументDOM.ПолучитьЭлементыПоИмени("СведТов");

	Для Индекс = 0 По СписокТоваров.Количество() - 1 Цикл

		ЭлементТовар = СписокТоваров.Элемент(Индекс);

		// НаимТов — наименование товара (атрибут элемента СведТов)
		НаименованиеТовара = ЭлементТовар.ПолучитьАтрибут("НаимТов");

		// ДопСведТов → КодТов = артикул из файла
		АртикулИзФайла = "";
		СписокДопСвед = ЭлементТовар.ПолучитьЭлементыПоИмени("ДопСведТов");
		Если СписокДопСвед.Количество() > 0 Тогда
			АртикулИзФайла = СписокДопСвед.Элемент(0).ПолучитьАтрибут("КодТов");
		КонецЕсли;

		// НомСредИдентТов → КИЗ (коды маркировки, может быть несколько)
		// Каждый КИЗ — отдельная строка таблицы
		СписокКИЗ = ЭлементТовар.ПолучитьЭлементыПоИмени("КИЗ");

		Для ИндексКИЗ = 0 По СписокКИЗ.Количество() - 1 Цикл

			КодМаркировки = СписокКИЗ.Элемент(ИндексКИЗ).ТекстовоеСодержимое;

			// Извлечь GTIN: 13 цифр после "010" в начале кода маркировки
			// Пример: 0104620341096812215r&gJu.4;z%:; → GTIN = 4620341096812
			GTIN = "";
			Если СтрНачинаетсяС(КодМаркировки, "010") Тогда
				GTIN = Сред(КодМаркировки, 4, 13);
			КонецЕсли;

			// Поиск номенклатуры по GTIN в регистре ШтрихкодыНоменклатуры
			НайденнаяНоменклатура = Неопределено;
			Артикул    = "";
			ЕстьВБазе  = Ложь;

			Если ЗначениеЗаполнено(GTIN) Тогда

				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
				|	ШтрихкодыНоменклатуры.Номенклатура.Артикул КАК Артикул
				|ИЗ
				|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
				|ГДЕ
				|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
				Запрос.УстановитьПараметр("Штрихкод", GTIN);

				Результат = Запрос.Выполнить();
				Если НЕ Результат.Пустой() Тогда
					Выборка = Результат.Выбрать();
					Выборка.Следующий();
					НайденнаяНоменклатура = Выборка.Номенклатура;
					Артикул    = Выборка.Артикул;
					ЕстьВБазе  = Истина;
				КонецЕсли;

			КонецЕсли;

			// Заполнить строку таблицы
			НоваяСтрока = ТаблицаДанныхИзФайла.Добавить();
			НоваяСтрока.АртикулФ                          = АртикулИзФайла;
			НоваяСтрока.НаименованиеФ                     = НаименованиеТовара;
			НоваяСтрока.GTIN                              = GTIN;
			НоваяСтрока.СокращенныйКодМаркировкиИзФайла   = КодМаркировки;

			Если ЕстьВБазе Тогда
				НоваяСтрока.ЕстьВБазе    = Истина;
				НоваяСтрока.Номенклатура  = НайденнаяНоменклатура;
				НоваяСтрока.Артикул       = Артикул;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
